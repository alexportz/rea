diff --git a/src/client/localplayer.cpp b/src/client/localplayer.cpp
index 8ddb23b..77a312d 100644
--- a/src/client/localplayer.cpp
+++ b/src/client/localplayer.cpp
@@ -739,3 +739,27 @@ void LocalPlayer::setSerene(const bool serene)
 
     callLuaField("onSereneChange", serene, oldSerene);
 }
+
+std::map<std::string, std::string> LocalPlayer::getStatOrigins()
+{
+    const auto self = reinterpret_cast<uintptr_t>(this);
+    const auto describe = [self](const char* member, const void* address) {
+        const auto addr = reinterpret_cast<uintptr_t>(address);
+        return fmt::format("Memoria: LocalPlayer em 0x{:016X}, campo {} em 0x{:016X} (offset +{} no objeto)",
+                           self, member, addr, addr - self);
+    };
+    const std::pair<const char*, std::pair<const char*, const void*>> fields[] = {
+        { "health", { "m_health", &m_health } },
+        { "maxHealth", { "m_maxHealth", &m_maxHealth } },
+        { "mana", { "m_mana", &m_mana } },
+        { "maxMana", { "m_maxMana", &m_maxMana } },
+        { "freeCapacity", { "m_freeCapacity", &m_freeCapacity } },
+    };
+    std::map<std::string, std::string> result;
+    for (const auto& [name, member] : fields) {
+        const auto it = m_statOrigins.find(name);
+        const std::string origin = it != m_statOrigins.end() ? it->second : "Ainda nao chegou nenhum pacote 0xA0.";
+        result[name] = origin + "\n" + describe(member.first, member.second);
+    }
+    return result;
+}
